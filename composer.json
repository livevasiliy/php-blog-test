{
  "name": "blog-php/mvc-blog",
  "description": "A simple MVC blog built with plain PHP",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "smarty/smarty": "^4.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Database\\": "database/",
      "Psr\\": "src/Framework/Psr/"
    }
  },
  "scripts": {
    "migrate": "php bin/migrations migrate",
    "seed": "php database/seed.php",
    "format": "php-cs-fixer fix",
    "format:check": "php-cs-fixer check --diff --verbose"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.0"
  }
}
