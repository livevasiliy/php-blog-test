{
  "name": "blog-php/mvc-blog",
  "description": "A simple MVC blog built with plain PHP and Smarty",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "doctrine/dbal": "^3.8",
    "smarty/smarty": "^4.5",
    "symfony/cache": "^6.4",
    "symfony/dependency-injection": "^6.4",
    "symfony/http-foundation": "^6.4",
    "symfony/routing": "^6.4",
    "symfony/validator": "^6.4"
  },
  "require-dev": {
    "doctrine/migrations": "^3.9",
    "friendsofphp/php-cs-fixer": "^3.64",
    "symfony/console": "^6.4",
    "symfony/event-dispatcher": "^6.4",
    "symfony/filesystem": "^6.4",
    "symfony/finder": "^6.4",
    "symfony/options-resolver": "^6.4",
    "symfony/process": "^6.4",
    "symfony/stopwatch": "^6.4",
    "symfony/string": "^6.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Database\\": "database/"
    }
  },
  "scripts": {
    "migrate": "php bin/migrations migrate",
    "migration-status": "php bin/migrations status",
    "seed": "php database/seed.php",
    "cs:check": "php-cs-fixer check --diff",
    "cs:fix": "php-cs-fixer fix"
  }
}
