{
  "name": "blog-php/mvc-blog",
  "description": "A simple MVC blog built with plain PHP",
  "type": "project",
  "require": { "php": ">=8.1" },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Database\\": "database/"
    }
  },
  "scripts": {
    "migrate": "php bin/migrations migrate",
    "seed": "php database/seed.php"
  }
}
